import numpy as np, pandas as pd

# build regularized row/col bias model by alternating updates
mu = train['value'].mean()
rows = train['row_id'].values.astype(np.int64)
cols = train['col_id'].values.astype(np.int64)
y = train['value'].values.astype(np.float64)

n_rows = train.row_id.max() + 1
n_cols = train.col_id.max() + 1

# aggregate indices for efficient updates by sorting once
order_r = np.argsort(rows)
rows_s = rows[order_r]
cols_s_r = cols[order_r]
y_s_r = y[order_r]
r_starts = np.r_[0, np.flatnonzero(np.diff(rows_s)) + 1]
r_ids = rows_s[r_starts]
r_ends = np.r_[r_starts[1:], len(rows_s)]

order_c = np.argsort(cols)
cols_s = cols[order_c]
rows_s_c = rows[order_c]
y_s_c = y[order_c]
c_starts = np.r_[0, np.flatnonzero(np.diff(cols_s)) + 1]
c_ids = cols_s[c_starts]
c_ends = np.r_[c_starts[1:], len(cols_s)]

lam = 10.0
br = np.zeros(n_rows)
bc = np.zeros(n_cols)
for it in range(10):
    for idx, r in enumerate(r_ids):
        s, e = r_starts[idx], r_ends[idx]
        br[r] = (y_s_r[s:e] - mu - bc[cols_s_r[s:e]]).sum() / (lam + e - s)
    for idx, c in enumerate(c_ids):
        s, e = c_starts[idx], c_ends[idx]
        bc[c] = (y_s_c[s:e] - mu - br[rows_s_c[s:e]]).sum() / (lam + e - s)
    pred_train = mu + br[rows] + bc[cols]
    rmse = np.sqrt(np.mean((y - pred_train)**2))
    print('iter', it, 'train rmse', rmse)

pred = dev_pairs.copy()
predv = mu + br[pred.row_id.values] + bc[pred.col_id.values]
predv = np.clip(predv, 1, 5)
pred['prediction'] = predv
pred.to_csv('pred
