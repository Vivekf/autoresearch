c_ids = cols_s[c_starts]
c_ends = np.r_[c_starts[1:], len(cols_s)]

n_rows = train.row_id.max()+1
n_cols = train.col_id.max()+1

k = 20
lam = 0.1
lam_b = 10.0
np.random.seed(0)
P = 0.1*np.random.randn(n_rows, k)
Q = 0.1*np.random.randn(n_cols, k)
br = np.zeros(n_rows)
bc = np.zeros(n_cols)
I = np.eye(k)

for it in range(6):
    # update row factors and row biases
    for idx, r in enumerate(r_ids):
        s, e = r_starts[idx], r_ends[idx]
        js = cols_s_r[s:e]
        yv = y_s_r[s:e]
        # update bias using current factors
        br[r] = (yv - mu - bc[js] - (Q[js] @ P[r])).sum() / (lam_b + e - s)
