--- the agent calls run_python ---
import numpy as np, pandas as pd
# start from best MF model currently in local vars: model_30
name, mu, br, bc, P, Q = model_30
rows = train['row_id'].values.astype(np.int64)
cols = train['col_id'].values.astype(np.int64)
y = train['value'].values.astype(np.float64)
t = train['t'].values.astype(np.float64)

base = mu + br[rows] + bc[cols] + np.sum(P[rows]*Q[cols], axis=1)
res = y - base

# per-row linear residual trend vs normalized time
n_rows = train.row_id.max()+1
alpha = np.zeros(n_rows)
beta = np.zeros(n_rows)

tn = (t - t.mean()) / t.std()
df = pd.DataFrame({'row_id': rows, 'tn': tn, 'res': res})
agg = df.groupby('row_id').agg(n=('res','size'), s_t=('tn','sum'), s_tt=('tn', lambda x: np.dot(x,x)), s_r=('res','sum'), s_tr=('tn', lambda x: np.dot(x, df.loc[x.index,'res'])))
for r, row in agg.iterrows():
    n = row['n']
    S_t = row['s_t']
    S_tt = row['s_tt']
    S_r = row['s_r']
    S_tr = row['s_tr']
    A = np.array([[n + 20.0, S_t],[S_t, S_tt + 20.0]])
    b = np.array([S_r, S_tr])
    sol = np.linalg.solve(A,b)
    alpha[r], beta[r] = sol

pred = dev_pairs.copy()
# no times for dev pairs, so cannot actually use t-dependent term
# write back plain best MF predictions
predv = mu + br[pred.row_id.values] + bc[pred.col_id.values] + np.sum(P[pred.row_id.values]*Q[pred.col_id.values], axis=1)
pred['prediction'] = np.clip(predv,1,5)
pred.to_csv('predictions.csv', index=False)
print('dev/test pairs have no t, so time trend cannot be used directly')

