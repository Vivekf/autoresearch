import pandas as pd
import numpy as np

train = pd.read_csv('train.csv')
dev = pd.read_csv('dev_pairs.csv')

mu = train.rating.mean()
lam_m = 10.0
lam_u = 15.0

# movie bias
movie_grp = train.groupby('movie').rating.agg(['sum','count'])
b_m = (movie_grp['sum'] - mu * movie_grp['count']) / (movie_grp['count'] + lam_m)
train2 = train.join(b_m.rename('b_m'), on='movie')

# user bias after movie bias
resid = train2['rating'] - mu - train2['b_m']
user_df = pd.DataFrame({'user': train2['user'], 'resid': resid})
user_grp = user_df.groupby('user').resid.agg(['sum','count'])
b_u = user_grp['sum'] / (user_grp['count'] + lam_u)

pred = dev.copy()
pred = pred.merge(b_m.rename('b_m'), left_on='movie', right_index=True, how='left')
pred = pred.merge(b_u.rename('b_u'), left_on='user', right_index=True, how='left')
pred['b_m'] = pred['b_m'].fillna(0.0)
pred['b_u'] = pred['b_u'].fillna(0.0)
pred['prediction'] = (mu + pred['b_m'] + pred['b_u']).clip(1,5)
pred[['user','movie','prediction']].to_csv('predictions.csv', index=False)
print('pred stats', pred.prediction.describe())
