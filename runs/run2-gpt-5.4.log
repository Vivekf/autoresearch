import pandas as pd
import numpy as np

train = pd.read_csv('train.csv')
dev = pd.read_csv('dev_pairs.csv')

mu = train.rating.mean()
movie_stats = train.groupby('movie').rating.agg(['mean','count'])
# simple shrinkage toward global mean
alpha = 10.0
movie_pred = mu + (movie_stats['mean'] - mu) * (movie_stats['count'] / (movie_stats['count'] + alpha))

pred = dev.copy()
pred = pred.merge(movie_pred.rename('prediction'), left_on='movie', right_index=True, how='left')
pred['prediction'] = pred['prediction'].fillna(mu).clip(1,5)
pred.to_csv('predictions.csv', index=False)
print('done', mu, pred.prediction.mean())
