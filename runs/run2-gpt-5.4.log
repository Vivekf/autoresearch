--- the agent calls run_python ---
import pandas as pd
import numpy as np
import time

train = pd.read_csv('train.csv')
dev = pd.read_csv('dev_pairs.csv')

# map ids to contiguous indices
user_ids = np.sort(train.user.unique())
movie_ids = np.sort(train.movie.unique())
u2i = {u:i for i,u in enumerate(user_ids)}
m2i = {m:i for i,m in enumerate(movie_ids)}

u = train.user.map(u2i).to_numpy(np.int32)
m = train.movie.map(m2i).to_numpy(np.int32)
r = train.rating.to_numpy(np.float64)

n_users = len(user_ids)
n_movies = len(movie_ids)
mu = r.mean()

k = 20
epochs = 12
lr = 0.01
reg = 0.05
reg_b = 0.02
rng = np.random.default_rng(0)
P = rng.normal(0, 0.1, size=(n_users, k))
Q = rng.normal(0, 0.1, size=(n_movies, k))
bu = np.zeros(n_users)
bi = np.zeros(n_movies)

idx = np.arange(len(r))
for ep in range(epochs):
    rng.shuffle(idx)
    se = 0.0
    t0 = time.time()
    for j in idx:
        uu = u[j]; ii = m[j]; rr = r[j]
        pred = mu + bu[uu] + bi[ii] + np.dot(P[uu], Q[ii])
        err = rr - pred
        se += err * err
        bu[uu] += lr * (err - reg_b * bu[uu])
        bi[ii] += lr * (err - reg_b * bi[ii])
        pu = P[uu].copy()
        qi = Q[ii].copy()
        P[uu] += lr * (err * qi - reg * pu)
        Q[ii] += lr * (err * pu - reg * qi)
    rmse = np.sqrt(se / len(r))
    print(f'epoch {ep+1} train_rmse {rmse:.4f} time {time.time()-t0:.1f}s')
    if ep in [5,8]:
        lr *= 0.7

# predictions
pred = dev.copy()
pred_u = pred.user.map(u2i)
pred_m = pred.movie.map(m2i)
out = np.full(len(pred), mu, dty
