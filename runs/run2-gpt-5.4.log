reg = 0.05
reg_b = 0.02
rng = np.random.default_rng(3)
P = rng.normal(0, 0.1, size=(n_users, k))
Q = rng.normal(0, 0.1, size=(n_movies, k))
bu = np.zeros(n_users)
bi = np.zeros(n_movies)
idx = np.arange(len(r))

for ep in range(epochs):
    rng.shuffle(idx)
    se = 0.0
    for j in idx:
        uu = u[j]; ii = m[j]; rr = r[j]
        pred = mu + bu[uu] + bi[ii] + np.dot(P[uu], Q[ii])
        err = rr - pred
        se += err * err
        bu[uu] += lr * (err - reg_b * bu[uu])
        bi[ii] += lr * (err - reg_b * bi[ii])
        pu = P[uu].copy()
        qi = Q[ii].copy()
        P[uu] += lr * (err * qi - reg * pu)
        Q[ii] += lr * (err * pu - reg * qi)
    print(f'epoch {ep+1} train_rmse {np.sqrt(se/len(r)):.4f}')
    if ep in [6,11]:
        lr *= 0.75

