# Prepare ids and grouped indices for bias model
import numpy as np, pandas as pd
rows = train.row_id.values.astype(np.int32)
cols = train.col_id.values.astype(np.int32)
y = train.value.values.astype(np.float64)
mu = y.mean()
max_row = max(train.row_id.max(), dev_pairs.row_id.max(), test_pairs.row_id.max())
max_col = max(train.col_id.max(), dev_pairs.col_id.max(), test_pairs.col_id.max())

# create arrays by id direct indexing
row_ids = np.arange(max_row+1)
col_ids = np.arange(max_col+1)

def fit_bias(lam=10.0, n_iter=20):
    br = np.zeros(max_row+1)
    bc = np.zeros(max_col+1)
    # precompute group order? use bincount each iter
    row_count = np.bincount(rows, minlength=max_row+1).astype(float)
    col_count = np.bincount(cols, minlength=max_col+1).astype(float)
    for it in range(n_iter):
        resid = y - mu - bc[cols]
        br = np.bincount(rows, weights=resid, minlength=max_row+1) / (row_count + lam)
        resid = y - mu - br[rows]
        bc = np.bincount(cols, weights=resid, minlength=max_col+1) / (col_count + lam)
    return br, bc
br10, bc10 = fit_bias(10, 30)
p = mu + br10[dev_pairs.row_id.values] + bc10[dev_pairs.col_id.values]
p = np.clip(p, 1, 5)
out = dev_pairs.copy(); out['prediction']=p; out.to_csv('predictions.csv', index=False)
print('bias lam10 pred range', p.min(), p.max())
