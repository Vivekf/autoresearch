def fit_bias_subset(rows_s, cols_s, y_s, lam=3.0, n_iter=30):
    br = np.zeros(max_row+1); bc = np.zeros(max_col+1); mu_s=y_s.mean()
    rc = np.bincount(rows_s, minlength=max_row+1).astype(float)
    cc = np.bincount(cols_s, minlength=max_col+1).astype(float)
    for it in range(n_iter):
        br = np.bincount(rows_s, weights=y_s-mu_s-bc[cols_s], minlength=max_row+1)/(rc+lam)
        bc = np.bincount(cols_s, weights=y_s-mu_s-br[rows_s], minlength=max_col+1)/(cc+lam)
    return mu_s, br, bc
for lam in [0.3,1,2,3,5,10,20]:
    mu_s, br_s, bc_s = fit_bias_subset(rows_tr, cols_tr, y_tr, lam, 40)
    pv = np.clip(mu_s+br_s[rows_val]+bc_s[cols_val],1,5)
    rmse=np.sqrt(np.mean((pv-y_val)**2))
    print('lam',lam,'val rmse',rmse)
