# Build contiguous mappings (row ids are mostly contiguous, cols have gaps)
unique_rows = np.arange(max_row+1)  # direct id indexing ok
unique_cols = np.arange(max_col+1)
ri = rows
ci = cols
n_r = max_row+1
n_c = max_col+1

# initialize with bias lam=3
br_base, bc_base = fit_bias(3.0, 50)

def train_mf_sgd(k=20, epochs=10, lr=0.01, reg=0.05, seed=0, init_bias=True, shuffle=True, verbose=True):
    rng = np.random.default_rng(seed)
    P = 0.05 * rng.standard_normal((n_r, k))
    Q = 0.05 * rng.standard_normal((n_c, k))
    br = br_base.copy() if init_bias else np.zeros(n_r)
    bc = bc_base.copy() if init_bias else np.zeros(n_c)
    idx = np.arange(len(y))
    lr0 = lr
    for ep in range(epochs):
        if shuffle:
            rng.shuffle(idx)
        se = 0.0
        # local vars for speed
        for ind in idx:
            r = ri[ind]; c = ci[ind]
            pred = mu + br[r] + bc[c] + P[r].dot(Q[c])
            e = y[ind] - pred
            se += e*e
            br[r] += lr * (e - reg*br[r])
            bc[c] += lr * (e - reg*bc[c])
            pr = P[r].copy()
            qc = Q[c].copy()
            P[r] += lr * (e*qc - reg*pr)
            Q[c] += lr * (e*pr - reg*qc)
        if verbose:
            print('ep', ep+1, 'train_rmse', (se/len(y))**0.5, 'lr', lr)
        lr *= 0.9
    return P,Q,br,bc

P20,Q20,br20,bc20 = train_mf_sgd(k=20, epochs=8, lr=0.007, reg=0.04, seed=1)
p = mu + br20[dev_pairs.row_id.values] + bc20[dev_pairs.col_id.values] + np.sum(P20[dev_pairs.row_id.values]*Q20[dev_pairs.col_id.values], axis=1)
p = np.clip(p,1,5)
out = dev_pairs.copy(); out['prediction']=p; out.to_csv('predictions.csv', index=False)
print('dev pred', p.min(), p.max(), p.mean())
