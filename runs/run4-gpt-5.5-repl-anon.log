--- the agent calls run_python ---
# collect dev predictions from available ALS models
def pred_from(P,Q,br,bc,pairs=dev_pairs, clip=True):
    pp=mu+br[pairs.row_id.values]+bc[pairs.col_id.values]+np.sum(P[pairs.row_id.values]*Q[pairs.col_id.values],axis=1)
    return np.clip(pp,1,5) if clip else pp
preds={}
for name in ['als','als3','als5','als6','als7','als8','als9','als2','als4']:
    P=globals().get('P'+name); Q=globals().get('Q'+name); br=globals().get('br'+name); bc=globals().get('bc'+name)
    if P is not None:
        preds[name]=pred_from(P,Q,br,bc)
        print(name, preds[name].mean(), preds[name].std())
# bias pred
preds['bias3']=np.clip(mu+br_base[dev_pairs.row_id.values]+bc_base[dev_pairs.col_id.values],1,5)
# Try a few fixed ensembles
for keys in [ ['als6','als8'], ['als6','als3','als5','als7','als8','als9'], ['als6','als8','als'], ['als6','als8','bias3'], ['als6','als3','als8'] ]:
    p=np.mean([preds[k] for k in keys],axis=0)
    out=dev_pairs.copy(); out['prediction']=p; out.to_csv('predictions.csv',index=False)
    print('wrote ensemble', keys, 'mean', p.mean(), 'std', p.std())
    break
