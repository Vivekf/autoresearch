# weighted ensemble: core models higher, diverse weak models lower
weights = {'als6':1.5,'als8':1.5,'als7':1.2,'als3':1.0,'als5':1.0,'als9':1.0,'als4':0.7,'als10':0.8,'als11':0.5,'als12':0.8}
keys=list(weights)
w=np.array([weights[k] for k in keys]); w=w/w.sum()
p=sum(wi*preds[k] for wi,k in zip(w,keys))
