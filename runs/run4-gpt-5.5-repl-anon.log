# Build grouped observations for ALS on full data
from collections import defaultdict

def make_groups(rows_arr, cols_arr, vals_arr):
    user_items=[[] for _ in range(max_row+1)]
    user_vals=[[] for _ in range(max_row+1)]
    item_users=[[] for _ in range(max_col+1)]
    item_vals=[[] for _ in range(max_col+1)]
    for r,c,v in zip(rows_arr, cols_arr, vals_arr):
        user_items[r].append(c); user_vals[r].append(v)
        item_users[c].append(r); item_vals[c].append(v)
    user_items=[np.array(x,dtype=np.int32) for x in user_items]
    user_vals=[np.array(x,dtype=np.float64) for x in user_vals]
    item_users=[np.array(x,dtype=np.int32) for x in item_users]
    item_vals=[np.array(x,dtype=np.float64) for x in item_vals]
    return user_items,user_vals,item_users,item_vals

# maybe create for full once
user_items,user_vals,item_users,item_vals = make_groups(rows, cols, y)
print('groups built')

def als_full(k=10, lam=20.0, n_iter=8, seed=0, bias_lam=3.0):
    rng=np.random.default_rng(seed)
    br,bc=fit_bias(bias_lam,50)
    P=0.05*rng.standard_normal((max_row+1,k))
    Q=0.05*rng.standard_normal((max_col+1,k))
    I=np.eye(k)
    for it in range(n_iter):
        for r in range(max_row+1):
            idxc=user_items[r]
            if idxc.size==0: continue
            Qc=Q[idxc]
            target=user_vals[r]-mu-br[r]-bc[idxc]
            A=Qc.T@Qc + lam*I
            b=Qc.T@target
            P[r]=np.linalg.solve(A,b)
        for c in range(max_col+1):
            idxr=item_users[c]
            if idxr.size==0: continue
            Pr=P[idxr]
            target=item_vals[c]-mu-bc[c]-br[idxr]
            A=Pr.T@Pr + lam*I
            b=Pr.T@target
            Q[c]=np.linalg.solve(A,b)
        # train rmse quick
        pred_train=mu+br[rows]+bc[cols]+np.sum(P[rows]*Q[cols],axis=1)
        print('als iter',it+1,'train rmse',np.sqrt(np.mean((pred_train-y)**2)))
    return P,Q,br,bc

Pals,Qals,brals,bcals=als_full(k=20, lam=30.0, n_iter=6, seed=2)
p=mu+brals[dev_pairs.row_id.values]+bcals[dev_pairs.col_id.values]+np.sum(Pals[dev_pairs.row_id.values]*Qals[dev_pairs.col_id.values],axis=1)
p=np.clip(p,1,5)
out=dev_pairs.copy(); out['prediction']=p; out.to_csv('predictions.csv',index=False)
print('wrote ALS', p.min(), p.max(), p.mean())
