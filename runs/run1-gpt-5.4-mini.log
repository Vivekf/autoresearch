import pandas as pd, numpy as np
train=pd.read_csv('train.csv')
dev=pd.read_csv('dev_pairs.csv')
mu=train.rating.mean()
# use best regularized user/movie bias from earlier
lb_u=8; lb_m=12
bu = pd.Series(0.0, index=train.user.unique())
bm = pd.Series(0.0, index=train.movie.unique())
for _ in range(20):
    bu = train.groupby('user').apply(lambda g: (g.rating - mu - g.movie.map(bm).fillna(0).to_numpy()).sum() / (len(g)+lb_u))
    bm = train.groupby('movie').apply(lambda g: (g.rating - mu - g.user.map(bu).fillna(0).to_numpy()).sum() / (len(g)+lb_m))
# per-user calibration on residuals (lightweight)
res = train.rating - (mu + train.user.map(bu).fillna(0) + train.movie.map(bm).fillna(0))
user_mean_res = train.assign(res=res).groupby('user').res.mean()
# shrink further to avoid overfit
user_mean_res = user_mean_res * (train.groupby('user').size() / (train.groupby('user').size() + 20.0))
pred = mu + dev.user.map(bu).fillna(0).to_numpy() + dev.movie.map(bm).fillna(0).to_numpy() + dev.user.map(user_mean_res).fillna(0).to_numpy()
pred=np.clip(pred,1,5)
out=dev.copy(); out['prediction']=pred
out.to_csv('predictions.csv',index=False)
print('done')

