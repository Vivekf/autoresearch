--- the agent calls run_python ---
import pandas as pd, numpy as np
train=pd.read_csv('train.csv')
dev=pd.read_csv('dev_pairs.csv')
mu=train.rating.mean()
lb_u=10; lb_m=10
bu = pd.Series(0.0, index=train.user.unique())
bm = pd.Series(0.0, index=train.movie.unique())
for _ in range(20):
    bu = train.groupby('user').apply(lambda g: (g.rating - mu - g.movie.map(bm).fillna(0).to_numpy()).sum() / (len(g)+lb_u))
    bm = train.groupby('movie').apply(lambda g: (g.rating - mu - g.user.map(bu).fillna(0).to_numpy()).sum() / (len(g)+lb_m))
# save best dev predictions
pred = np.clip(mu + dev.user.map(bu).fillna(0).to_numpy() + dev.movie.map(bm).fillna(0).to_numpy(),1,5)
out=dev.copy(); out['prediction']=pred
out.to_csv('predictions.csv',index=False)
# write test predictions too
te=pd.read_csv('test_pairs.csv')
predt=np.clip(mu + te.user.map(bu).fillna(0).to_numpy() + te.movie.map(bm).fillna(0).to_numpy(),1,5)
outt=te.copy(); outt['prediction']=predt
outt.to_csv('test_predictions.csv',index=False)
print('wrote test_predictions.csv')

